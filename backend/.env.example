# Copy to backend/.env (gitignored). Never commit real keys. Never paste keys in chats.

# Chat provider: openai (brief default, gpt-4.1-mini) or gemini (team-approved alternative via
# Gemini's OpenAI-compatible endpoint). Only the selected provider's key is used.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Relative paths resolve from the repository root.
DATA_DIR=data/processed
SOURCES_DIR=data/sources
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
CHAT_TIMEOUT_SECONDS=25
CHAT_RATE_LIMIT_PER_MINUTE=20
# true = serve Person 1's labeled demo corpus (data/processed/demo, is_demo=true).
DEMO_FIXTURES=false
