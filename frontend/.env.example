# Public, browser-visible settings only. Never put OPENAI_API_KEY or any secret here.

# true  -> use the labeled demo fixtures in src/api/mockClient.js (shows a DEMO banner)
# false -> call the real backend at VITE_API_BASE_URL
VITE_USE_FIXTURES=true

# Backend base URL (Person 2). Default local API port is 8000.
VITE_API_BASE_URL=http://localhost:8000

# Request timeout in ms for the API adapter.
VITE_API_TIMEOUT_MS=15000
